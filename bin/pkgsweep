#!/usr/bin/env python3
import os, sys
here = os.path.dirname(os.path.realpath(__file__))
for p in (os.path.join(here, ".."), os.path.join(here, "..", "lib", "pkgsweep")):
    if os.path.isdir(os.path.join(p, "pkgsweep")):
        sys.path.insert(0, p)
        break
from pkgsweep.__main__ import main
sys.exit(main())
